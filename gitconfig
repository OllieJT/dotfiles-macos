[user]
	name = Ollie Taylor
	email = 13766232+OllieJT@users.noreply.github.com
[hub]
	protocol = ssh
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[core]
	ignorecase = false
	excludesfile = ~/.gitignore
	editor = code --wait
[mergetool "gitblade"]
	cmd = \"/usr/lib/gitblade/gitblade\" -c \"\"
	trustExitCode = true
	prompt = true
[mergetool]
	trustExitCode = true
	prompt = true
[difftool]
	prompt = false
[credential]
	helper = cache --timeout=3600
[color]
	diff = auto
	status = auto
	branch = auto
	ui = true
[help]
	autocorrect = 1
[init]
	templateDir = ~/.config/git/template/
[gpg]
	format = ssh
[gpg "ssh"]
	program = /Applications/1Password.app/Contents/MacOS/op-ssh-sign

[http]
	postBuffer = 157286400
[rerere]
	enabled = true
[coderabbit]
	machineId = cli/f896530ba22948c0a748e1e58b97703b
